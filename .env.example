POSTGRES_DB=montana_real_estate
POSTGRES_USER=mret
POSTGRES_PASSWORD=changeme

# Optional. Set this to enable POST /api/ingest (manual re-ingestion trigger) — required
# as a Bearer token on that request. Leave unset to keep the endpoint disabled entirely.
INGEST_TOKEN=

# Required only if you enable the mcp-server profile (docker compose --profile mcp up).
# The MCP server refuses to start without it — required as a Bearer token on every MCP
# request. mcp-server is published directly to the host (no nginx in front of it), so
# this is the only thing gating that exposure.
MCP_TOKEN=

# Optional. Comma-separated hostnames (e.g. "192.168.0.205:3100") to restrict the MCP
# server's Host-header validation to. Leave unset to keep current behavior (validation
# disabled, a warning is logged) — MCP_TOKEN is the primary access control either way.
MCP_ALLOWED_HOSTS=

# Optional. Free key from fred.stlouisfed.org/docs/api/api_key.html (instant signup).
# Enables real median-listing-price/active-listings/days-on-market data per county from
# FRED (sourced from Realtor.com's Housing Inventory Core Metrics — only exists for
# populous counties; small rural counties routinely have no series at all, and that's
# expected). Leave unset to skip this entirely — the self-computed assessed-value layer
# in market_metrics works regardless.
FRED_API_KEY=
