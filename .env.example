POSTGRES_DB=montana_real_estate
POSTGRES_USER=mret
POSTGRES_PASSWORD=changeme

# Optional. Set this to enable POST /api/ingest (manual re-ingestion trigger) — required
# as a Bearer token on that request. Leave unset to keep the endpoint disabled entirely.
INGEST_TOKEN=

# Required only if you enable the mcp-server profile (docker compose --profile mcp up).
# The MCP server refuses to start without it — required as a Bearer token on every MCP
# request. mcp-server is published directly to the host (no nginx in front of it), so
# this is the only thing gating that exposure.
MCP_TOKEN=
